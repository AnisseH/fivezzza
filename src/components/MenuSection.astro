---
import type { Category } from '../data/menu';

interface Props { menu: Category[]; }
const { menu } = Astro.props;

const pizza     = menu.find(c => c.id === 'pizza')!;
const antipasti = menu.find(c => c.id === 'antipasti')!;
const dessert   = menu.find(c => c.id === 'dessert')!;
---

<section class="menu" id="menu">
  <div class="checker"></div>
  <img src="/pizza-deco.png" class="menu__deco menu__deco--1" aria-hidden="true" alt="" />
  <img src="/pizza-deco.png" class="menu__deco menu__deco--2" aria-hidden="true" alt="" />
  <img src="/pizza-deco.png" class="menu__deco menu__deco--3" aria-hidden="true" alt="" />
  <img src="/pizza-deco.png" class="menu__deco menu__deco--4" aria-hidden="true" alt="" />

  <div class="menu__inner">

    <!-- LEFT: Pizza -->
    <div class="menu__col">
      <h2 class="menu__cat-title">{pizza.name}</h2>

      <ul class="menu__list">
        {pizza.items.map(item => (
          <li class="menu__item">
            <div class="menu__item-row">
              <span class="menu__item-name">{item.name}</span>
              <span class="menu__item-line" aria-hidden="true"></span>
              <span class="menu__item-price">{item.price}&thinsp;€</span>
            </div>
            {item.description && <p class="menu__item-desc">{item.description}</p>}
          </li>
        ))}
      </ul>

      {pizza.note && (
        <div class="menu__note-row">
          <span class="menu__note-label">{pizza.note.label}</span>
          <span class="menu__note-detail">{pizza.note.detail}</span>
          <span class="menu__item-line" aria-hidden="true"></span>
          <span class="menu__item-price">{pizza.note.price}&thinsp;€</span>
        </div>
      )}
    </div>

    <!-- RIGHT: Antipasti + Dessert -->
    <div class="menu__col">
      <h2 class="menu__cat-title">{antipasti.name}</h2>
      <ul class="menu__list">
        {antipasti.items.map(item => (
          <li class="menu__item">
            <div class="menu__item-row">
              <span class="menu__item-name">{item.name}</span>
              <span class="menu__item-line" aria-hidden="true"></span>
              <span class="menu__item-price">{item.price}&thinsp;€</span>
            </div>
            {item.description && <p class="menu__item-desc">{item.description}</p>}
          </li>
        ))}
      </ul>

      <h2 class="menu__cat-title menu__cat-title--spaced">{dessert.name}</h2>
      <ul class="menu__list">
        {dessert.items.map(item => (
          <li class="menu__item">
            <div class="menu__item-row">
              <span class="menu__item-name">{item.name}</span>
              <span class="menu__item-line" aria-hidden="true"></span>
              <span class="menu__item-price">{item.price}&thinsp;€</span>
            </div>
            {item.description && <p class="menu__item-desc">{item.description}</p>}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>

<style>
  .menu {
    background: var(--cream);
    position: relative;
    overflow: hidden;
  }

  .menu__deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0.25;
    z-index: 0;
  }
  .menu__deco--1 { width: 320px; top: -60px;    left: -60px;  rotate: -18deg; }
  .menu__deco--2 { width: 160px; top: 30%;      right: -20px; rotate: 25deg;  }
  .menu__deco--3 { width: 420px; bottom: 40px;  left: 38%;    rotate: -8deg;  }
  .menu__deco--4 { width: 220px; bottom: -30px; right: 28%;   rotate: 12deg;  }

  .menu__inner { position: relative; z-index: 1; }

  .menu__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── Category title ── */
  .menu__cat-title {
    font-family: 'Bungee Shade', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--blue);
    text-align: center;
    letter-spacing: 0.06em;
    margin-bottom: 1.75rem;
    line-height: 1.1;
  }
  .menu__cat-title--spaced { margin-top: 3rem; }

  /* ── Item list ── */
  .menu__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .menu__item-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .menu__item-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.12em;
    color: var(--red);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Leader line */
  .menu__item-line {
    flex: 1;
    border-bottom: 2px solid var(--red);
    margin-bottom: 0.3rem;
    min-width: 1rem;
  }

  .menu__item-price {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    color: var(--red);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .menu__item-desc {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    line-height: 1.5;
    margin-top: 0.2rem;
  }

  /* ── Supplements row ── */
  .menu__note-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 2px solid var(--red);
  }

  .menu__note-label {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0.14em;
    color: var(--blue);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .menu__note-detail {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    white-space: nowrap;
    flex-shrink: 0;
    margin-left: 0.25rem;
  }

  @media (max-width: 820px) {
    .menu__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 1.5rem 4rem;
    }
    .menu__cat-title--spaced { margin-top: 2rem; }
  }
</style>
