---
import { Icon } from 'astro-icon/components';

interface Props {
  schedule?: Array<{ day: string; hours: string }>;
}

const { schedule = [
  { day: 'Lundi',     hours: 'Fermé' },
  { day: 'Mardi',     hours: 'Fermé' },
  { day: 'Mercredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Jeudi',     hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Vendredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Samedi',    hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Dimanche',  hours: '12h00 – 14h00' },
]} = Astro.props;
---

<section class="hours" id="hours">
  <div class="checker checker--dark"></div>

  <!-- Instagram strip — before the hours grid -->
  <a
    href="https://www.instagram.com/fivezzza/"
    target="_blank"
    rel="noopener noreferrer"
    class="hours__ig-strip"
    aria-label="Suivez Fivezzza sur Instagram"
  >
    <Icon name="lucide:instagram" class="hours__ig-strip-icon" />
    <span class="hours__ig-strip-text">Suivez-nous sur Instagram</span>
    <span class="hours__ig-strip-handle">@fivezzza</span>
    <span class="hours__ig-strip-arrow" aria-hidden="true">→</span>
  </a>

  <div class="hours__inner">

    <!-- LEFT — schedule -->
    <div class="hours__schedule">
      <p class="hours__label">Retrouvez-nous</p>
      <h2 class="hours__title">
        <Icon name="lucide:clock" class="hours__title-icon" />
        Horaires
      </h2>
      <table class="hours__table" aria-label="Horaires d'ouverture">
        <tbody>
          {schedule.map(({ day, hours }) => (
            <tr class={hours === 'Fermé' ? 'hours__row--closed' : ''}>
              <td class="hours__day">{day}</td>
              <td class="hours__time">{hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- RIGHT — address -->
    <div class="hours__contact">
      <p class="hours__label">Où nous trouver</p>
      <h2 class="hours__title">
        <Icon name="lucide:map-pin" class="hours__title-icon" />
        Adresse
      </h2>
      <a
        href="https://maps.app.goo.gl/4Sbf9ZhPRvgA2esM6"
        target="_blank"
        rel="noopener noreferrer"
        class="hours__address-link"
      >
        <address class="hours__address">
          Pass. de l'Internationale<br />
          59800 Lille<br />
          France
        </address>
      </a>
      <p class="hours__address-note">
        Au sein de la Halle Gourmande<br />de Chaud Bouillon
      </p>
    </div>

  </div>
</section>

<style>
  .hours {
    background: var(--dark);
    color: var(--cream);
  }

  /* Instagram strip */
  .hours__ig-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.1rem 2rem;
    background: var(--red-on-dark);
    color: var(--cream);
    text-decoration: none;
    transition: background 0.2s;
  }
  .hours__ig-strip:hover { background: var(--red-d); }
  .hours__ig-strip-icon { width: 1.3rem; height: 1.3rem; flex-shrink: 0; }
  .hours__ig-strip-text {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hours__ig-strip-handle {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
  }
  .hours__ig-strip-arrow {
    display: inline-block;
    font-family: sans-serif;
    transition: transform 0.2s ease;
  }
  .hours__ig-strip:hover .hours__ig-strip-arrow { transform: translateX(5px); }

  /* Grid */
  .hours__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* Shared column header */
  .hours__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red-on-dark);
    margin-bottom: 0.4rem;
  }
  .hours__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    letter-spacing: 0.05em;
    color: var(--cream);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hours__title-icon {
    width: clamp(1.8rem, 3.5vw, 2.8rem);
    height: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--red);
    flex-shrink: 0;
  }

  /* Table */
  .hours__table { width: 100%; border-collapse: collapse; }
  .hours__table tr { border-bottom: 1px solid rgba(245,237,216,0.1); }
  .hours__table tr:last-child { border-bottom: none; }
  .hours__day, .hours__time { padding: 0.7rem 0; font-size: 0.9rem; }
  .hours__day { font-weight: 600; color: var(--cream); width: 40%; }
  .hours__time { color: #BDB6A8; }
  .hours__row--closed .hours__day,
  .hours__row--closed .hours__time { color: #8C8696; }

  /* Address */
  .hours__address-link { text-decoration: none; display: inline-block; }
  .hours__address-link:hover .hours__address { color: var(--cream); }
  .hours__address {
    font-style: normal;
    font-size: 1.1rem;
    line-height: 1.9;
    color: rgba(245,237,216,0.8);
  }
  .hours__address-note {
    margin-top: 1.5rem;
    font-size: 0.82rem;
    line-height: 1.7;
    color: rgba(245,237,216,0.6);
    letter-spacing: 0.04em;
  }

  @media (max-width: 820px) {
    .hours__inner { grid-template-columns: 1fr; gap: 2.5rem; padding: 3rem 1.5rem 4rem; }
    .hours__ig-strip { flex-wrap: wrap; gap: 0.5rem; text-align: center; padding: 1rem; }
  }
</style>
