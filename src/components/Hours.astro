---
import { Icon } from 'astro-icon/components';

const schedule = [
  { day: 'Lundi',     hours: 'Fermé' },
  { day: 'Mardi',     hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Mercredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Jeudi',     hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Vendredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Samedi',    hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Dimanche',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
];
---

<section class="hours" id="hours">
  <div class="checker checker--dark"></div>

  <div class="hours__inner">
    <div class="hours__schedule">
      <p class="hours__label">Retrouvez-nous</p>
      <h2 class="hours__title">
        <Icon name="lucide:clock" class="hours__title-icon" />
        Horaires & Adresse
      </h2>

      <table class="hours__table" aria-label="Horaires d'ouverture">
        <tbody>
          {schedule.map(({ day, hours }) => (
            <tr class={hours === 'Fermé' ? 'hours__row--closed' : ''}>
              <td class="hours__day">{day}</td>
              <td class="hours__time">{hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="hours__contact">
      <div class="hours__info-block">
        <p class="hours__info-label">
          <Icon name="lucide:map-pin" class="hours__info-icon" />
          Adresse
        </p>
        <address class="hours__address">
          Pass. de l'Internationale<br />
          59800 Lille<br />
          France
        </address>
      </div>

      <div class="hours__info-block">
        <p class="hours__info-label">
          <Icon name="lucide:instagram" class="hours__info-icon" />
          Instagram
        </p>
        <a
          href="https://www.instagram.com/fivezzza/"
          target="_blank"
          rel="noopener noreferrer"
          class="hours__ig"
        >
          @fivezzza
        </a>
      </div>

      <div class="hours__map">
        <div class="hours__map-facade" id="map-facade" role="button" tabindex="0" aria-label="Afficher la carte Google Maps">
          <svg class="hours__map-pin" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          <span>Voir sur Google Maps</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hours {
    background: var(--dark);
    color: var(--cream);
  }
  .hours__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .hours__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red-on-dark);
    margin-bottom: 0.4rem;
  }
  .hours__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 0.04em;
    color: var(--cream);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hours__title-icon {
    width: clamp(1.8rem, 3.5vw, 2.8rem);
    height: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--red);
    flex-shrink: 0;
  }

  /* Table */
  .hours__table { width: 100%; border-collapse: collapse; }
  .hours__table tr { border-bottom: 1px solid rgba(245,237,216,0.1); }
  .hours__table tr:last-child { border-bottom: none; }
  .hours__day, .hours__time { padding: 0.7rem 0; font-size: 0.9rem; }
  .hours__day { font-weight: 600; color: var(--cream); width: 40%; }
  .hours__time { color: #BDB6A8; } /* was rgba(cream, 0.65) — same visual, accessible solid */
  .hours__row--closed .hours__day,
  .hours__row--closed .hours__time { color: #8C8696; } /* 4.9:1 on --dark */

  /* Contact side */
  .hours__info-block { margin-bottom: 1.75rem; }
  .hours__info-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red-on-dark);
    margin-bottom: 0.4rem;
  }
  .hours__info-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }
  .hours__address {
    font-style: normal;
    line-height: 1.65;
    color: rgba(245,237,216,0.8);
  }
  .hours__ig {
    color: var(--cream);
    text-decoration: none;
    font-weight: 400;
    transition: color 0.2s;
  }
  .hours__ig:hover { color: var(--red); }

  /* Map */
  .hours__map {
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--grey);
    margin-top: 0.5rem;
    overflow: hidden;
  }
  .hours__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .hours__map-facade {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    cursor: pointer;
    color: rgba(245,237,216,0.7);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: color 0.2s;
    user-select: none;
  }
  .hours__map-facade:hover { color: var(--cream); }
  .hours__map-pin {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--red-on-dark);
  }

  @media (max-width: 820px) {
    .hours__inner { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>

<script>
  const facade = document.getElementById('map-facade');
  function loadMap() {
    if (!facade) return;
    const iframe = document.createElement('iframe');
    iframe.title = "Fivezzza Pizzeria — Pass. de l'Internationale, Lille";
    iframe.src = 'https://maps.google.com/maps?q=50.6276912,3.0927066&z=17&output=embed&hl=fr';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    facade.replaceWith(iframe);
  }
  facade?.addEventListener('click', loadMap);
  facade?.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') loadMap(); });
</script>
