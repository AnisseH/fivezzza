---
import { Icon } from 'astro-icon/components';

const schedule = [
  { day: 'Lundi',     hours: 'Fermé' },
  { day: 'Mardi',     hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Mercredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Jeudi',     hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Vendredi',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Samedi',    hours: '12h00 – 14h00 · 19h00 – 22h00' },
  { day: 'Dimanche',  hours: '12h00 – 14h00 · 19h00 – 22h00' },
];
---

<section class="hours" id="hours">
  <div class="checker checker--dark"></div>

  <div class="hours__inner">
    <div class="hours__schedule">
      <p class="hours__label">Retrouvez-nous</p>
      <h2 class="hours__title">
        <Icon name="lucide:clock" class="hours__title-icon" />
        Horaires & Adresse
      </h2>

      <table class="hours__table" aria-label="Horaires d'ouverture">
        <tbody>
          {schedule.map(({ day, hours }) => (
            <tr class={hours === 'Fermé' ? 'hours__row--closed' : ''}>
              <td class="hours__day">{day}</td>
              <td class="hours__time">{hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="hours__contact">
      <div class="hours__info-block">
        <p class="hours__info-label">
          <Icon name="lucide:map-pin" class="hours__info-icon" />
          Adresse
        </p>
        <address class="hours__address">
          Pass. de l'Internationale<br />
          59800 Lille<br />
          France
        </address>
      </div>

      <div class="hours__info-block">
        <p class="hours__info-label">
          <Icon name="lucide:instagram" class="hours__info-icon" />
          Instagram
        </p>
        <a
          href="https://www.instagram.com/fivezzza/"
          target="_blank"
          rel="noopener noreferrer"
          class="hours__ig"
        >
          @fivezzza
        </a>
      </div>

      <div class="hours__map">
        <iframe
          title="Fivezzza Pizzeria — Pass. de l'Internationale, Lille"
          src="https://maps.google.com/maps?q=50.6276912,3.0927066&z=17&output=embed&hl=fr"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .hours {
    background: var(--dark);
    color: var(--cream);
  }
  .hours__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .hours__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.4rem;
  }
  .hours__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: 0.04em;
    color: var(--cream);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hours__title-icon {
    width: clamp(1.8rem, 3.5vw, 2.8rem);
    height: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--red);
    flex-shrink: 0;
  }

  /* Table */
  .hours__table { width: 100%; border-collapse: collapse; }
  .hours__table tr { border-bottom: 1px solid rgba(245,237,216,0.1); }
  .hours__table tr:last-child { border-bottom: none; }
  .hours__day, .hours__time { padding: 0.7rem 0; font-size: 0.9rem; }
  .hours__day { font-weight: 600; color: var(--cream); width: 40%; }
  .hours__time { color: rgba(245,237,216,0.65); }
  .hours__row--closed .hours__day,
  .hours__row--closed .hours__time { color: rgba(245,237,216,0.3); }

  /* Contact side */
  .hours__info-block { margin-bottom: 1.75rem; }
  .hours__info-label {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.4rem;
  }
  .hours__info-icon {
    width: 0.95rem;
    height: 0.95rem;
    flex-shrink: 0;
  }
  .hours__address {
    font-style: normal;
    line-height: 1.65;
    color: rgba(245,237,216,0.8);
  }
  .hours__ig {
    color: var(--cream);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  .hours__ig:hover { color: var(--red); }

  /* Map */
  .hours__map {
    width: 100%;
    aspect-ratio: 4/3;
    background: var(--grey);
    margin-top: 0.5rem;
    overflow: hidden;
  }

  @media (max-width: 820px) {
    .hours__inner { grid-template-columns: 1fr; gap: 3rem; }
  }
</style>
