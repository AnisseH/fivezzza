---
import { Icon } from 'astro-icon/components';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__inner">
    <a href="#home" class="footer__logo">
      <img src="/logo.jpeg" alt="Fivezzza Pizzeria" width="72" height="72" loading="lazy" />
    </a>
    <p class="footer__tagline">Pizza artisanale · Pâte maison</p>

    <a
      href="https://www.instagram.com/fivezzza/"
      target="_blank"
      rel="noopener noreferrer"
      class="footer__ig"
      aria-label="Fivezzza sur Instagram"
    >
      <Icon name="simple-icons:instagram" class="footer__ig-icon" />
      <span>@fivezzza</span>
    </a>

    <nav class="footer__nav" aria-label="Footer navigation">
      <a href="#menu">La Carte</a>
      <span aria-hidden="true">·</span>
      <a href="#about">Notre Histoire</a>
      <span aria-hidden="true">·</span>
      <a href="#hours">Horaires</a>
    </nav>
    <p class="footer__copy">&copy; {year} Fivezzza Pizzeria. Tous droits réservés.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--cream);
    text-align: center;
  }
  .footer__inner {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .footer__logo img {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(245,237,216,0.3);
    margin-bottom: 0.5rem;
    transition: border-color 0.2s;
  }
  .footer__logo:hover img { border-color: var(--red); }

  .footer__tagline {
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(245,237,216,0.5);
  }

  /* Instagram button */
  .footer__ig {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.4rem;
    border: 1.5px solid rgba(245,237,216,0.2);
    color: var(--cream);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    margin: 0.25rem 0;
  }
  .footer__ig:hover {
    border-color: var(--red);
    background: var(--red);
    color: var(--cream);
  }
  .footer__ig-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .footer__nav {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .footer__nav a {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(245,237,216,0.7);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer__nav a:hover { color: var(--red); }
  .footer__nav span { color: rgba(245,237,216,0.25); }

  .footer__copy {
    font-size: 0.75rem;
    color: rgba(245,237,216,0.3);
    margin-top: 0.5rem;
  }
</style>
