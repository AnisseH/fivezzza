---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logoImg from "../assets/logo-full.png";
---

<section class="about" id="about">
  {[1, 2, 3].map(n => (
    <img src="/pizza-deco.png" class={`about__deco about__deco--${n}`} aria-hidden="true" alt="" loading="lazy" />
  ))}
  <div class="about__inner">
    <!-- Badge side -->
    <div class="about__visual">
      <Image
        src={logoImg}
        alt="Fivezzza Pizzeria logo"
        width={420}
        height={247}
        quality={85}
        loading="lazy"
      />
    </div>

    <!-- Text side -->
    <div class="about__text">
      <p class="about__label">Notre Histoire</p>
      <h2 class="about__title">
        Fait avec passion,<br /><em>servi avec amour.</em>
      </h2>
      <p class="about__body">
        Chez Fivezzza, chaque pizza est le fruit d'un savoir-faire artisanal
        transmis avec fierté. Notre pâte, levée lentement pendant 72 heures, et
        nos ingrédients soigneusement sélectionnés font toute la différence — du
        premier regard jusqu'à la dernière bouchée.
      </p>
      <p class="about__body">
        Retrouvez-nous à la <a
          href="https://www.chaudbouillon.earth/"
          target="_blank"
          rel="noopener noreferrer"
          class="about__link">Halle Gourmande de Chaud Bouillon</a
        >, un collectif de cuisiniers artisanaux au cœur de Lille.
      </p>
      <p class="about__body">
        Nos produits d'exception sont sourcés chez <a
          href="https://www.carliervogliazzo.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="about__link">Carlier Vogliazzo</a
        >, l'épicerie italienne de référence.
      </p>

      <!-- Feature pills -->
      <ul class="about__features">
        <li class="about__feature">
          <Icon name="lucide:chef-hat" class="about__feature-icon" />
          Fait maison
        </li>
        <li class="about__feature">
          <Icon name="lucide:leaf" class="about__feature-icon" />
          Ingrédients frais
        </li>
        <li class="about__feature">
          <Icon name="lucide:clock" class="about__feature-icon" />
          Pâte 72h
        </li>
      </ul>

      <a href="#menu" class="btn btn--red about__cta">Découvrir la Carte</a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--cream);
    padding: 5rem 2rem 6rem;
    position: relative;
    overflow: hidden;
  }

  .about__deco {
    position: absolute;
    pointer-events: none;
    user-select: none;
    opacity: 0.25;
    z-index: 0;
  }
  .about__deco--1 {
    width: 280px;
    top: -60px;
    left: -40px;
    rotate: 15deg;
  }
  .about__deco--2 {
    width: 180px;
    bottom: -20px;
    right: 2%;
    rotate: -22deg;
  }
  .about__deco--3 {
    width: 380px;
    top: 30%;
    left: 48%;
    rotate: 8deg;
  }

  .about__inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 5rem;
  }

  .about__visual {
    flex-shrink: 0;
    position: relative;
  }

  .about__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red-a11y);
    margin-bottom: 0.5rem;
  }
  .about__title {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.04em;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }
  .about__title em {
    font-style: normal;
    color: var(--red);
  }
  .about__body {
    font-size: 1rem;
    line-height: 1.75;
    color: #3d3846;
    margin-bottom: 1rem;
    max-width: 52ch;
  }
  .about__link {
    color: var(--red-a11y);
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .about__link:hover {
    color: var(--blue);
  }

  /* Feature pills */
  .about__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    list-style: none;
    margin: 1.5rem 0;
  }
  .about__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--dark);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--dark);
  }
  .about__feature-icon {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--red);
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .about__inner {
      flex-direction: column;
      gap: 2rem;
      text-align: center;
    }
    .about__body {
      max-width: 100%;
    }
    .about__features {
      justify-content: center;
    }
    .about__visual img {
      max-width: 80vw;
      height: auto;
    }
    .about__cta {
      align-self: center;
    }
  }
</style>
