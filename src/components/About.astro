---
import { Icon } from 'astro-icon/components';
---
<section class="about" id="about">
  <div class="about__inner">
    <!-- Badge side -->
    <div class="about__visual" aria-hidden="true">
      <div class="about__ring">
        <img src="/logo.jpeg" alt="" width="264" height="264" loading="lazy" />
      </div>
      <div class="about__dots"></div>
    </div>

    <!-- Text side -->
    <div class="about__text">
      <p class="about__label">Notre Histoire</p>
      <h2 class="about__title">Fait avec passion,<br /><em>servi avec amour.</em></h2>
      <p class="about__body">
        Chez Fivezzza, chaque pizza est le fruit d'un savoir-faire artisanal transmis avec fierté.
        Notre pâte, levée lentement pendant 48 heures, et nos ingrédients soigneusement sélectionnés
        font toute la différence — du premier regard jusqu'à la dernière bouchée.
      </p>
      <p class="about__body">
        Parce qu'une bonne pizza, ça ne s'improvise pas.
      </p>

      <!-- Feature pills -->
      <ul class="about__features">
        <li class="about__feature">
          <Icon name="lucide:flame" class="about__feature-icon" />
          Four à bois
        </li>
        <li class="about__feature">
          <Icon name="lucide:leaf" class="about__feature-icon" />
          Ingrédients frais
        </li>
        <li class="about__feature">
          <Icon name="lucide:clock" class="about__feature-icon" />
          Pâte 48h
        </li>
      </ul>

      <a href="#menu" class="btn btn--red about__cta">Découvrir la Carte</a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--cream);
    padding: 6rem 2rem;
  }
  .about__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 5rem;
  }

  .about__visual { flex-shrink: 0; position: relative; }
  .about__ring {
    width: 280px;
    height: 280px;
    border-radius: 50%;
    border: 6px solid var(--blue);
    padding: 8px;
    box-shadow: 8px 8px 0 var(--red);
  }
  .about__ring img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .about__dots {
    position: absolute;
    inset: -24px -24px auto auto;
    width: 120px;
    height: 120px;
    background-image: repeating-conic-gradient(var(--red) 0% 25%, transparent 0% 50%);
    background-size: 16px 16px;
    opacity: 0.25;
    z-index: -1;
  }

  .about__label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.5rem;
  }
  .about__title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }
  .about__title em { font-style: italic; color: var(--red); }
  .about__body {
    font-size: 1rem;
    line-height: 1.75;
    color: #3d3846;
    margin-bottom: 1rem;
    max-width: 52ch;
  }

  /* Feature pills */
  .about__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    list-style: none;
    margin: 1.5rem 0;
  }
  .about__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--dark);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--dark);
  }
  .about__feature-icon {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--red);
    flex-shrink: 0;
  }

  @media (max-width: 820px) {
    .about__inner { flex-direction: column; gap: 3rem; text-align: center; }
    .about__body { max-width: 100%; }
    .about__features { justify-content: center; }
    .about__dots { inset: -16px -16px auto auto; width: 80px; height: 80px; }
  }
</style>
