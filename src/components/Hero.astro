---
---
<section class="hero" id="home">
  <!-- thin checker stripe at very top -->
  <div class="checker hero__stripe-top"></div>

  <div class="hero__stage">
    <div class="hero__content">
      <!-- Logo badge -->
      <div class="hero__badge">
        <img src="/logo.jpeg" alt="Fivezzza Pizzeria logo" />
      </div>

      <!-- Text -->
      <div class="hero__text">
        <p class="hero__eyebrow">Bienvenue chez</p>
        <h1 class="hero__title">Fivezzza</h1>
        <p class="hero__tagline">Pizza artisanale &middot; Pâte maison &middot; Ingrédients frais</p>
        <div class="hero__ctas">
          <a href="#menu" class="btn btn--red">Voir la Carte</a>
          <a href="#hours" class="btn btn--outline">Nous Trouver</a>
        </div>
      </div>
    </div>

    <!-- decorative corner checkers -->
    <div class="hero__corner hero__corner--tl" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--tr" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--bl" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--br" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .hero__stripe-top { height: 10px; }

  .hero__stage {
    flex: 1;
    position: relative;
    background-color: var(--dark);
    background-image: url('/hero-bg.jpg');
    background-size: cover;
    background-position: center 60%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
  }

  /* dark gradient overlay so text stays readable */
  .hero__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(26,23,32,0.85) 0%, rgba(26,23,32,0.6) 100%);
    pointer-events: none;
  }

  /* Corner checker squares */
  .hero__corner {
    position: absolute;
    width: 180px;
    height: 180px;
    background-image: repeating-conic-gradient(var(--red) 0% 25%, transparent 0% 50%);
    background-size: 30px 30px;
    opacity: 0.28;
  }
  .hero__corner--tl { top: 0; left: 0; }
  .hero__corner--tr { top: 0; right: 0; }
  .hero__corner--bl { bottom: 0; left: 0; }
  .hero__corner--br { bottom: 0; right: 0; }

  .hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 5rem;
    max-width: 1100px;
    width: 100%;
  }

  /* Logo badge */
  .hero__badge {
    flex-shrink: 0;
  }
  .hero__badge img {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    object-fit: cover;
    border: 5px solid var(--red);
    box-shadow:
      0 0 0 10px rgba(224,68,44,0.15),
      0 30px 80px rgba(0,0,0,0.6);
  }

  /* Text block */
  .hero__text { color: var(--cream); }

  .hero__eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.4rem;
  }

  .hero__title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(5.5rem, 13vw, 11rem);
    line-height: 0.88;
    letter-spacing: 0.04em;
    color: var(--cream);
    margin-bottom: 1.25rem;
  }

  .hero__tagline {
    font-size: 1rem;
    color: rgba(245,237,216,0.6);
    letter-spacing: 0.06em;
    margin-bottom: 2.25rem;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .hero__content {
      flex-direction: column;
      text-align: center;
      gap: 2.5rem;
    }
    .hero__badge img { width: 180px; height: 180px; }
    .hero__ctas { justify-content: center; }
    .hero__corner { width: 100px; height: 100px; }
  }
</style>
