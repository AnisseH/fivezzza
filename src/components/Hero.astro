---
import { Image } from 'astro:assets';
import heroImg from '../assets/hero-bg.jpg';
---

<section class="hero" id="home">
  <div class="checker hero__stripe-top"></div>

  <div class="hero__stage">
    <!-- LCP image — optimized to WebP by Astro, eager loaded -->
    <Image
      src={heroImg}
      alt=""
      class="hero__bg-img"
      loading="eager"
      fetchpriority="high"
      quality={50}
      widths={[768, 1280, 1920]}
      sizes="100vw"
    />
    <!-- Gradient overlay -->
    <div class="hero__overlay" aria-hidden="true"></div>

    <div class="hero__content">
      <div class="hero__badge">
        <!-- Ring: cream circle, blue border, red drop-shadow -->
        <div class="hero__ring">
          <!-- Image first = behind the SVG text ring -->
          <img
            src="/favicon-512x512.png"
            alt="Fivezzza Pizzeria logo"
            width="246"
            height="246"
            fetchpriority="high"
            loading="eager"
            class="hero__ring-img"
          />

          <!-- SVG second = on top so text is readable over the image edge -->
          <svg
            class="hero__ring-text"
            viewBox="0 0 300 300"
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <!--
                Image: inset 32px → CSS r=123 → SVG r≈115.
                Text sits just outside the image edge in the cream band.
                FIVEZZZA arc r=120 → glyphs extend outward toward blue border.
                pizzeria  arc r=126 → glyphs extend inward to r≈112 (just inside image edge).
              -->
              <path id="fivezzza-arc" d="M 30,150 A 120,120 0 0,1 270,150"/>
              <path id="pizzeria-arc" d="M 24,150 A 126,126 0 0,0 276,150"/>
            </defs>

            <!-- FIVEZZZA at top, brand red, Bungee Shade -->
            <text
              fill="#ed5838"
              stroke="#ed5838"
              stroke-width="0.8"
              paint-order="stroke fill"
              font-family="'Bungee Shade', cursive"
              font-size="21"
              letter-spacing="5"
            >
              <textPath href="#fivezzza-arc" text-anchor="middle" startOffset="50%">FIVEZZZA</textPath>
            </text>

            <!-- pizzeria at bottom, brand blue, Playfair italic -->
            <text
              fill="#2855B5"
              stroke="#2855B5"
              stroke-width="0.8"
              paint-order="stroke fill"
              font-family="'Fredoka', sans-serif"
              font-size="16"
              letter-spacing="5"
            >
              <textPath href="#pizzeria-arc" text-anchor="middle" startOffset="50%">PIZZERIA</textPath>
            </text>
          </svg>
        </div>
      </div>

      <div class="hero__text">
        <p class="hero__eyebrow">Bienvenue chez</p>
        <h1 class="hero__title">Fivezzza</h1>
        <p class="hero__tagline">Pizza artisanale &middot; Pâte maison &middot; Ingrédients frais</p>
        <div class="hero__ctas">
          <a href="#menu" class="btn btn--red">Voir la Carte</a>
          <a href="#hours" class="btn btn--outline">Nous Trouver</a>
        </div>
      </div>
    </div>

    <div class="hero__corner hero__corner--tl" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--tr" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--bl" aria-hidden="true"></div>
    <div class="hero__corner hero__corner--br" aria-hidden="true"></div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .hero__stripe-top { height: 10px; }

  .hero__stage {
    flex: 1;
    position: relative;
    background: var(--dark);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem 4rem;
    overflow: hidden;
  }

  /* Background image */
  .hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    z-index: 0;
  }

  /* Dark gradient overlay */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgba(26,23,32,0.82) 0%, rgba(26,23,32,0.55) 100%),
      rgba(255,246,232,0.08);
    z-index: 1;
  }

  /* Corner checker squares */
  .hero__corner {
    position: absolute;
    width: 180px;
    height: 180px;
    background-image: repeating-conic-gradient(var(--red) 0% 25%, transparent 0% 50%);
    background-size: 30px 30px;
    opacity: 0.28;
    z-index: 2;
  }
  .hero__corner--tl { top: 0; left: 0; }
  .hero__corner--tr { top: 0; right: 0; }
  .hero__corner--bl { bottom: 0; left: 0; }
  .hero__corner--br { bottom: 0; right: 0; }

  .hero__content {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 5rem;
    max-width: 1100px;
    width: 100%;
  }

  .hero__badge { flex-shrink: 0; }

  /* Ring: cream background, blue border, red offset shadow */
  .hero__ring {
    position: relative;
    width: 310px;
    height: 310px;
    border-radius: 50%;
    border: 6px solid var(--blue);
    background: var(--cream);
    box-shadow: 10px 10px 0 var(--red);
    display: flex;
    align-items: center;
    justify-content: center;
    /* no overflow:hidden — lets the SVG text be visible near the border */
  }

  /* Pizza image — inset controls size, no explicit width/height override */
  .hero__ring-img {
    position: absolute;
    inset: 32px;
    width: calc(100% - 64px);
    height: calc(100% - 64px);
    object-fit: contain;
  }

  /* SVG text ring — no z-index, so DOM order keeps it behind the image */
  .hero__ring-text {
    position: absolute;
    inset: -6px; /* compensate for the border so SVG coords align with ring edge */
    width: calc(100% + 12px);
    height: calc(100% + 12px);
    overflow: visible;
    pointer-events: none;
  }

  .hero__text { color: var(--cream); }

  .hero__eyebrow {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.4rem;
  }

  .hero__title {
    font-family: 'Bungee Shade', sans-serif;
    font-size: clamp(3.5rem, 9vw, 7rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    color: var(--cream);
    margin-bottom: 1.25rem;
  }

  .hero__tagline {
    font-size: 1rem;
    color: rgba(245,237,216,0.6);
    letter-spacing: 0.06em;
    margin-bottom: 2.25rem;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .hero__stage { padding: 4rem 1.5rem 3rem; }
    .hero__content { flex-direction: column; text-align: center; gap: 2rem; }
    .hero__ring { width: 230px; height: 230px; box-shadow: 6px 6px 0 var(--red); }
    .hero__ring-img { inset: 18px; width: calc(100% - 36px); height: calc(100% - 36px); }
    .hero__ctas { justify-content: center; }
    .hero__corner { width: 80px; height: 80px; }
  }
  @media (max-width: 420px) {
    .hero__ring { width: 190px; height: 190px; box-shadow: 5px 5px 0 var(--red); }
    .hero__ring-img { inset: 14px; width: calc(100% - 28px); height: calc(100% - 28px); }
    .hero__title { font-size: 3rem; }
  }
</style>
